# FeedbackOps AI — Environment Variables Example
# Copy to .env and fill in real values. NEVER commit the real .env.

# --- LLM Provider (pick ONE to start; adapter supports both) ---
# Gemini (free tier primary). Get yours: https://aistudio.google.com
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash

# Claude-ready adapter (optional, leave empty unless you have a key)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-5

# LLM adapter selection: gemini | claude
LLM_PROVIDER=gemini
LLM_TIMEOUT_SECONDS=30
LLM_MAX_RETRIES=2

# --- Webhook security (set a shared secret for POST /feedback) ---
WEBHOOK_SECRET=change_me_random_string

# --- Google Sheets audit log (optional; leave empty to use local fallback) ---
GOOGLE_SHEETS_DOC_ID=
GOOGLE_SERVICE_ACCOUNT_EMAIL=
# NOTE: paste the private key as a single line with \n escapes
GOOGLE_SERVICE_ACCOUNT_PRIVATE_KEY=

# --- Limits ---
MAX_FEEDBACK_LENGTH=2000
