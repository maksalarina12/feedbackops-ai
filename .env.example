# FeedbackOps AI — Environment Variables Example
# Copy to .env and fill in real values. NEVER commit the real .env.

# --- LLM Provider (pick ONE to start; adapter supports both) ---
# Gemini (free tier primary). Get yours: https://aistudio.google.com
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3.5-flash

# Claude-ready adapter (optional, leave empty unless you have a key)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-5

# LLM adapter selection: gemini | claude
LLM_PROVIDER=gemini
LLM_TIMEOUT_SECONDS=30
LLM_MAX_RETRIES=2

# --- Webhook security (required) ---
# Create an n8n Header Auth credential whose header name is X-Webhook-Secret
# and whose value matches this secret.
WEBHOOK_SECRET=change_me_random_string

# --- URLs ---
# Used by the Next.js server-side proxy (mirror it in frontend/.env.local)
# and by the weekly digest workflow.
N8N_WEBHOOK_URL=http://localhost:5678/webhook/feedbackops
N8N_BASE_URL=http://localhost:5678
# Optional: enables the escalation side-branch in the main workflow.
ESCALATION_WEBHOOK_URL=
# Optional: persists every audit row to the Next.js review queue.
# Docker Compose defaults to http://frontend:3000/api/audit. For n8n running
# directly on the host, use http://localhost:3000/api/audit.
AUDIT_WEBHOOK_URL=
# Frontend-only: SQLite audit database inside the Compose volume.
AUDIT_DB_PATH=/app/.data/audit.sqlite
# Optional: HMAC mode for /api/audit. When set, senders must include
# X-Audit-Timestamp and X-Audit-Signature (HMAC-SHA256 of "<ts>.<body>").
AUDIT_HMAC_SECRET=
# Optional: delete audit events older than N days (empty = keep).
AUDIT_RETENTION_DAYS=

# --- Review queue auth (required to use /review) ---
# Preferred: JSON map of username -> scrypt hash, e.g.
#   REVIEW_USERS='{"reviewer":"scrypt$<salt>$<hash>"}'
# Generate a hash:
#   printf '%s' 'your-password' | node scripts/hash_review_password.mjs
REVIEW_USERS=
# Used by scripts/seed_demo.py when performing a sample review action.
REVIEW_USERNAME=reviewer
# Legacy single shared password, used only when REVIEW_USERS is empty.
REVIEW_PASSWORD=
REVIEW_SESSION_SECRET=
# Optional: incoming webhook for escalation/digest notifications.
SLACK_WEBHOOK_URL=

# --- Google Sheets audit log (optional; leave empty to use local fallback) ---
GOOGLE_SHEETS_DOC_ID=
GOOGLE_SERVICE_ACCOUNT_EMAIL=
# NOTE: paste the private key as a single line with \n escapes
GOOGLE_SERVICE_ACCOUNT_PRIVATE_KEY=

# --- Limits ---
MAX_FEEDBACK_LENGTH=2000
