# Copy to frontend/.env.local for local development.
# These variables are server-side only: never prefix them with NEXT_PUBLIC_.
N8N_WEBHOOK_URL=http://localhost:5678/webhook/feedbackops
WEBHOOK_SECRET=change_me_random_string
# Optional: SQLite audit store (default .data/audit.sqlite).
AUDIT_DB_PATH=
# Optional: migrate an existing JSONL file on first open.
AUDIT_LOG_PATH=
# Optional: HMAC mode for n8n -> /api/audit.
AUDIT_HMAC_SECRET=
# Optional: retention window in days (empty = keep forever).
AUDIT_RETENTION_DAYS=
# Required for /review and /api/review. Prefer REVIEW_USERS (JSON username ->
# scrypt hash); generate a hash with:
#   printf '%s' 'your-password' | node ../scripts/hash_review_password.mjs
REVIEW_USERS=
# Legacy single shared password, used only when REVIEW_USERS is empty.
REVIEW_PASSWORD=
REVIEW_SESSION_SECRET=
# Optional: verifies Slack interactive callbacks (escalation approve buttons)
# at /api/slack/actions. Set it to the Slack app's signing secret.
SLACK_SIGNING_SECRET=
